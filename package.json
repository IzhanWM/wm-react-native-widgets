{
  "name": "@wavemaker/react-native-widgets",
  "description": "Standalone React Native widgets — QR code, avatar stack, segment progress, swipe deck, reorder list, signature pad, maps and Skia effects — for iOS, Android and web.",
  "version": "1.0.1",
  "license": "MIT",
  "main": "components/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/IzhanWM/wm-react-native-widgets.git"
  },
  "homepage": "https://wavemaker.github.io/wm-react-native-widgets",
  "keywords": [
    "react-native",
    "expo",
    "widgets",
    "ui-components",
    "qrcode",
    "avatar",
    "progress",
    "swipe",
    "reorder",
    "drag-and-drop",
    "signature",
    "apple-maps",
    "google-maps",
    "maps",
    "skia",
    "wavemaker",
    "wmx"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:clean": "rm -rf node_modules/.cache/storybook node_modules/.vite && storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:wmx": "node ./scripts/generate-wmx.js",
    "generate:images": "node ./scripts/generate-widget-images.js",
    "build:lib": "node ./scripts/build-lib.js",
    "prepare:npm": "node ./scripts/prepare-npm-package.js",
    "generate:package": "npm run build:lib && npm run prepare:npm",
    "publish:npm": "npm run generate:package && cd dist/npm-packages/widgets && npm publish",
    "deploy-storybook": "storybook-to-ghpages"
  },
  "dependencies": {
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-signature-canvas": "^5.1.1"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "expo": "*",
    "expo-location": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-maps": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*",
    "react-native-webview": "*"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-location": {
      "optional": true
    },
    "react-native-maps": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-links": "10.3.5",
    "@storybook/react": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@storybook/storybook-deployer": "^2.8.16",
    "@types/react": "~19.1.0",
    "adm-zip": "^0.5.16",
    "buffer": "^6.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo": "57.0.24",
    "expo-location": "~57.0.19",
    "playwright-core": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.82.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.5.1",
    "storybook": "10.3.5",
    "tslib": "2.3.0",
    "typescript": "~5.9.2",
    "vite": "^5.4.21"
  },
  "resolutions": {
    "tslib": "2.3.0"
  },
  "private": true
}
